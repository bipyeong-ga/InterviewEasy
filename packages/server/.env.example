PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=1234
DB_NAME=interview

# JWT
# Use a long random secret in production (eg. openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here
# Optional: token lifetime in seconds (default 7 days)
JWT_EXPIRES_IN_SECS=604800
JWT_ISSUER=intervieweasy

# CORS / Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# OAuth credentials (register apps with providers and put the client ids/secrets here)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NODE_ENV=development

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here